# Your Supabase project URL. Required for auth to work; the app throws on boot without it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase project's anon/public key. Required alongside NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the TELUVANE API the frontend talks to (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# This is a build-time variable: it must be set in the Vercel project's environment
# variables (not just a local .env.local) for it to take effect on the deployed site.
# The canonical production URL for this site (no trailing slash). Used for
# robots.txt, sitemap.xml, Open Graph images, and absolute metadata URLs.
# Set this to your real Vercel/custom domain before deploying. Do not leave
# it as localhost in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On-chain anchoring (Avalanche Fuji). These are build-time variables: set them
# in the Vercel project's environment variables, not just in a local .env.local.

# Address of the deployed SessionAnchorRegistry contract (from scripts/deploy_anchor.py).
# REQUIRED for independent verification. This is the pin that makes the browser
# check mean anything: with it set, the page reads anchoredAt(root) from a
# contract the deployer chose, so a compromised TELUVANE API cannot fake a
# "Verified" result.
#
# If this is left BLANK, neither the /verify page nor the dashboard anchor panel
# can do independent verification at all. The browser never reads any contract
# address from the API (that would defeat the point), so it reads nothing on
# chain: both surfaces drop to the "unpinned" state, show only what the TELUVANE
# API reports, and say on screen that the check is not independent. There is no
# fallback. Set this in the Vercel project's environment variables before you
# rely on the verification feature.
NEXT_PUBLIC_ANCHOR_CONTRACT_ADDRESS=

# Optional read-only RPC the browser uses to read the contract. If blank, viem's
# built-in public Avalanche Fuji endpoint is used. The API-supplied rpc_url is
# never used, whether or not this is set.
NEXT_PUBLIC_ANCHOR_RPC_URL=

# Prefix for building a block-explorer link to an anchor transaction. The tx
# hash is appended to this string.
NEXT_PUBLIC_ANCHOR_EXPLORER_TX_URL=https://testnet.snowtrace.io/tx/
