# API (Render)
DATABASE_URL=postgresql://postgres:<pwd>@<host>:6543/postgres   # Supabase transaction pooler
SUPABASE_URL=https://<project-ref>.supabase.co                  # used to fetch JWKS for asymmetric JWT verification
SUPABASE_JWT_SECRET=<legacy HS256 secret; optional now that projects sign JWTs asymmetrically>
BLACKBOX_SECRET_KEY=<python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())">
FRONTEND_ORIGIN=https://<your-app>.vercel.app
EVENTS_RATE_LIMIT=120/minute
AUDIT_RATE_LIMIT=20/minute

# On-chain anchoring (API). All optional. If ANCHOR_RPC_URL, ANCHOR_CONTRACT_ADDRESS,
# or ANCHOR_SIGNER_PRIVATE_KEY is absent the feature is inert: no batches, no errors.
# Avalanche Fuji RPC endpoint the API reads and submits through
ANCHOR_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Deployed SessionAnchorRegistry address (from scripts/deploy_anchor.py)
ANCHOR_CONTRACT_ADDRESS=0x...
# Platform Fuji hot wallet, 64 hex chars, funded with small amounts of test AVAX only
ANCHOR_SIGNER_PRIVATE_KEY=0x...
# Chain id: 43113 = Avalanche Fuji testnet
ANCHOR_CHAIN_ID=43113
# Only anchor sessions with no new events for at least this many minutes
ANCHOR_MIN_SESSION_AGE_MINUTES=30
# How often the scheduler runs an anchor pass
ANCHOR_BATCH_INTERVAL_MINUTES=10
# Confirmations required before a batch is marked mined
ANCHOR_CONFIRMATIONS=5
# Mark a submitted batch failed if it is not mined within this many minutes
ANCHOR_SUBMIT_TIMEOUT_MINUTES=30
# Log a warning when the signer balance falls below this many AVAX
ANCHOR_LOW_BALANCE_ALERT_AVAX=0.05
# Cap on manual POST /anchor/run calls per org per calendar month
ANCHOR_MAX_FORCED_RUNS_PER_ORG_PER_MONTH=20
# Minimum gap between one org's manual POST /anchor/run calls
ANCHOR_FORCED_RUN_COOLDOWN_MINUTES=5
# Explorer base URL for transaction links (batch tx hash is appended)
ANCHOR_EXPLORER_TX_URL=https://testnet.snowtrace.io/tx/

# Frontend (Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
NEXT_PUBLIC_API_URL=https://api.example.com

# On-chain anchoring (Frontend). Optional. The /verify page and AnchorPanel read
# contract metadata from the API, these are fallbacks for the browser client.
NEXT_PUBLIC_ANCHOR_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_ANCHOR_RPC_URL=
NEXT_PUBLIC_ANCHOR_EXPLORER_TX_URL=https://testnet.snowtrace.io/tx/
