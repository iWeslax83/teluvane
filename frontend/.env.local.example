# Your Supabase project URL. Required for auth to work; the app throws on boot without it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase project's anon/public key. Required alongside NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the TELUVANE API the frontend talks to (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# This is a build-time variable: it must be set in the Vercel project's environment
# variables (not just a local .env.local) for it to take effect on the deployed site.
# The canonical production URL for this site (no trailing slash). Used for
# robots.txt, sitemap.xml, Open Graph images, and absolute metadata URLs.
# Set this to your real Vercel/custom domain before deploying. Do not leave
# it as localhost in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On-chain anchoring (Avalanche Fuji). Leave these blank to hide the anchor
# verification UI entirely; the app works fine without them.

# Address of the deployed SessionAnchorRegistry contract (from scripts/deploy_anchor.py).
NEXT_PUBLIC_ANCHOR_CONTRACT_ADDRESS=

# Optional read-only RPC the browser uses to check anchoredAt(root) directly.
# If blank, the frontend trusts the API's verification result instead.
NEXT_PUBLIC_ANCHOR_RPC_URL=

# Prefix for building a block-explorer link to an anchor transaction. The tx
# hash is appended to this string.
NEXT_PUBLIC_ANCHOR_EXPLORER_TX_URL=https://testnet.snowtrace.io/tx/
